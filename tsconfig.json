{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": [
      "development"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "#cui",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ]
}